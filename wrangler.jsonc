{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "courtvision-live",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws/*", "/draft", "/friends"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DRAFT_ROOM",
        "class_name": "DraftRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DraftRoom"]
    }
  ]
}
